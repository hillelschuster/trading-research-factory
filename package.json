    "researchbrain:stage0-supervisor": "node scripts/run-researchbrain-stage0-supervisor.mjs",
    "researchbrain:stage0-readiness": "node scripts/run-researchbrain-stage0-readiness.mjs",
    "phase7b:exit-readiness": "node scripts/run-phase7b-exit-readiness.mjs",
    "phase7c:exit-readiness": "node scripts/run-phase7c-exit-readiness.mjs",
