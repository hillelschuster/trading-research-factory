    "gate:2": "node scripts/run-rollout-gate.mjs gate-2",
    "gate:3": "node scripts/run-rollout-gate.mjs gate-3",
    "gate:4": "node scripts/run-rollout-gate.mjs gate-4",
    "validate": "node scripts/validate-structure.mjs",
    "wfa:envelope": "node scripts/run-research-wfa-envelope-worker.mjs",
    "wfa:run": "node scripts/run-research-wfa-run-worker.mjs",
    "phase8a:exit-readiness": "node scripts/run-phase8a-exit-readiness.mjs",
    "phase8c:exit-readiness": "node scripts/run-phase8c-exit-readiness.mjs",
    "researchbrain:stage0-runtime": "node scripts/run-researchbrain-stage0-runtime.mjs",
    "researchbrain:stage0-loop": "node scripts/run-researchbrain-stage0-loop.mjs",
    "researchbrain:stage0-outbox": "node scripts/run-researchbrain-stage0-outbox-consumer.mjs",
