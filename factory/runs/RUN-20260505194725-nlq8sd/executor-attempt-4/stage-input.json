    "implementation_steps": [
      "1. Create strategy directory: walk forward engine/strategies/ema_trend_gate_bnb_hold_sensitivity/",
      "2. Create WFA config with hold_bars grid [96, 120, 144, 168, 192] and fixed core params",
      "3. Run WFA using walk_forward_smoke_test.py",
