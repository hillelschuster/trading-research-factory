  "plan": {
    "experiment_id": "EXP-20260513105000-bnb-hold-sensitivity",
    "title": "BNB EMA Trend Gate hold-period robustness bounded WFA",
    "backlog_item_id": "IDEA-783243-8vz",
    "objective": "Run bounded WFA on BNBUSDT EMA Trend Gate to test whether hold_bars values around prior 168-bar optimum are robust rather than overfit. Use narrow hold_bars grid [96, 120, 144, 168, 192] with fixed core parameters (EMA 50/20, RSI 14, RSI thresholds 45/55, SL 2.0 ATR, TP 2.0 RR).",
    "hypothesis": "Hold_bars values near 168 (96-192 range) will show similar OOS Sharpe and stability, indicating robustness rather than overfit. If only 168 works well while neighboring values fail, it suggests overfitting.",
    "strategy_rationale": "BNB previously showed 0.432 OOS Sharpe (marginally robust) and 0.6636 with 144/168 hold_bars. Testing expanded hold_bars grid tests whether the prior result was robust or lucky. Using fixed core params isolates hold_bars sensitivity.",
