{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m2.5-free",
  "plugin": ["opencode-agent-memory@0.2.0"],
  "instructions": [
    "src/prompts/runtime-invariants.md"
  ],
  "provider": {
    "opencode": {
      "options": {
        "timeout": false
      }
    }
  },
  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "glob": true,
    "grep": true,
    "list": true,
    "bash": true,
    "webfetch": true,
    "task": true,
    "skill": true
  },
  "permission": "allow",
  "agent": {
    "ideator": {
      "mode": "subagent",
      "model": "opencode/minimax-m2.5-free",
      "description": "Generates one explicit backlog candidate when the backlog needs replenishment.",
      "prompt": "{file:./src/prompts/ideator.md}",
      "permission": {
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    },
    "planner": {
      "mode": "subagent",
      "model": "opencode/minimax-m2.5-free",
      "description": "Designs narrow WFA-first experiment plans with explicit hypotheses, commands, and artifacts.",
      "prompt": "{file:./src/prompts/planner.md}",
      "permission": {
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    },
    "executor": {
      "mode": "subagent",
      "model": "opencode/minimax-m2.5-free",
      "description": "Executes the approved experiment plan inside the workspace and writes reproducible artifacts.",
      "prompt": "{file:./src/prompts/executor.md}",
      "permission": {
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny",
        "bash": {
          "*": "allow"
        }
      }
    },
    "evaluator": {
      "mode": "subagent",
      "model": "opencode/minimax-m2.5-free",
      "description": "Scores evidence quality, checks artifact completeness, and judges experiment outcomes.",
      "prompt": "{file:./src/prompts/evaluator.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    },
    "summarizer": {
      "mode": "subagent",
      "model": "opencode/minimax-m2.5-free",
      "description": "Compresses each run into durable lessons and next actions.",
      "prompt": "{file:./src/prompts/summarizer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
