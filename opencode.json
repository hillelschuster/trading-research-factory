{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "plugin": ["opencode-agent-memory@0.2.0"],
  "instructions": [
    "src/prompts/runtime-invariants.md"
  ],
  "provider": {
    "github-copilot": {
      "options": {
        "timeout": false
      }
    }
  },
  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "glob": true,
    "grep": true,
    "list": true,
    "bash": true,
    "webfetch": true,
    "task": true,
    "skill": true
  },
  "permission": "allow",
  "agent": {
    "explore": {
      "mode": "subagent",
      "reasoningEffort": "xhigh"
    },
    "general": {
      "mode": "subagent",
      "reasoningEffort": "xhigh"
    },
    "oracle": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "reasoningEffort": "xhigh",
      "description": "Read-only deep reviewer for difficult architecture, trading logic, risk, root-cause, and over-engineering decisions. Use selectively; Flash remains the normal worker.",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    },
    "ideator": {
      "mode": "subagent",
      "reasoningEffort": "xhigh",
      "description": "Generates one explicit backlog candidate when the backlog needs replenishment.",
      "prompt": "{file:./src/prompts/ideator.md}",
      "permission": {
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "oracle": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    },
    "planner": {
      "mode": "subagent",
      "reasoningEffort": "xhigh",
      "description": "Designs narrow WFA-first experiment plans with explicit hypotheses, commands, and artifacts.",
      "prompt": "{file:./src/prompts/planner.md}",
      "permission": {
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "oracle": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    },
    "executor": {
      "mode": "subagent",
      "reasoningEffort": "xhigh",
      "description": "Executes the approved experiment plan inside the workspace and writes reproducible artifacts.",
      "prompt": "{file:./src/prompts/executor.md}",
      "permission": {
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "oracle": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny",
        "bash": {
          "*": "allow"
        }
      }
    },
    "evaluator": {
      "mode": "subagent",
      "reasoningEffort": "xhigh",
      "description": "Scores evidence quality, checks artifact completeness, and judges experiment outcomes.",
      "prompt": "{file:./src/prompts/evaluator.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "oracle": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    },
    "summarizer": {
      "mode": "subagent",
      "reasoningEffort": "xhigh",
      "description": "Compresses each run into durable lessons and next actions.",
      "prompt": "{file:./src/prompts/summarizer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "planner": "allow",
          "executor": "allow",
          "evaluator": "allow",
          "summarizer": "allow",
          "oracle": "allow",
          "*": "deny"
        },
        "external_directory": "allow",
        "doom_loop": "deny"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
